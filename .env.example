# Key from sunor.cc (API Keys page in your dashboard)
SUNO_API_KEY=

# sunor.cc's API base (adjust if you switch providers)
SUNO_API_BASE=https://sunor.cc/api/v1

# Optional: shared secret Poke must send as `Authorization: Bearer <this>`
# Leave blank while testing locally.
MCP_SERVER_SECRET=

PORT=3000
